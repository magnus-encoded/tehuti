{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tehuti plugin manifest v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "executable",
    "app_ids",
    "events",
    "start",
    "permissions"
  ],
  "properties": {
    "id": {
      "type": [
        "string",
        "null"
      ]
    },
    "author": {
      "type": [
        "string",
        "null"
      ]
    },
    "security_contact": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "enum": [
        "application",
        "verb"
      ]
    },
    "verbs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^\\p{L}{1,32}$"
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "word",
              "locale"
            ],
            "properties": {
              "word": {
                "type": "string",
                "pattern": "^\\p{L}{1,32}$"
              },
              "locale": {
                "enum": [
                  "af",
                  "am",
                  "ar",
                  "as",
                  "az",
                  "ba",
                  "be",
                  "bg",
                  "bn",
                  "bo",
                  "br",
                  "bs",
                  "ca",
                  "cs",
                  "cy",
                  "da",
                  "de",
                  "el",
                  "en",
                  "es",
                  "et",
                  "eu",
                  "fa",
                  "fi",
                  "fo",
                  "fr",
                  "gl",
                  "gu",
                  "ha",
                  "haw",
                  "he",
                  "hi",
                  "hr",
                  "ht",
                  "hu",
                  "hy",
                  "id",
                  "is",
                  "it",
                  "ja",
                  "jw",
                  "ka",
                  "kk",
                  "km",
                  "kn",
                  "ko",
                  "la",
                  "lb",
                  "ln",
                  "lo",
                  "lt",
                  "lv",
                  "mg",
                  "mi",
                  "mk",
                  "ml",
                  "mn",
                  "mr",
                  "ms",
                  "mt",
                  "my",
                  "ne",
                  "nl",
                  "nn",
                  "no",
                  "oc",
                  "pa",
                  "pl",
                  "ps",
                  "pt",
                  "ro",
                  "ru",
                  "sa",
                  "sd",
                  "si",
                  "sk",
                  "sl",
                  "sn",
                  "so",
                  "sq",
                  "sr",
                  "su",
                  "sv",
                  "sw",
                  "ta",
                  "te",
                  "tg",
                  "th",
                  "tk",
                  "tl",
                  "tr",
                  "tt",
                  "uk",
                  "ur",
                  "uz",
                  "vi",
                  "yi",
                  "yo",
                  "yue",
                  "zh"
                ]
              },
              "hints": {
                "type": "array",
                "maxItems": 16,
                "items": {
                  "type": "string",
                  "pattern": "^[^\\u0000]*$"
                }
              }
            }
          }
        ]
      }
    },
    "executable": {
      "type": "string",
      "pattern": "\\S"
    },
    "app_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "enum": [
          "button",
          "focus",
          "speech"
        ]
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "enum": [
          "key",
          "text",
          "quit"
        ]
      }
    },
    "start": {
      "enum": [
        "always",
        "on_focus"
      ]
    },
    "adjusters": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "minimum",
          "maximum",
          "value"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 24
          },
          "minimum": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "maximum": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          },
          "value": {
            "type": "integer",
            "minimum": -2147483648,
            "maximum": 2147483647
          }
        }
      }
    }
  }
}
