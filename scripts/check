#!/usr/bin/env bash
# The full gate CI runs: format, lints, tests, prose rules.
set -euo pipefail
cd "$(dirname "$0")/.."
if [ -n "$(find crates -name Cargo.toml 2>/dev/null)" ]; then
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --locked -- -D warnings
    # The keymap fallback tests need a stable advertised map across hosts.
    XKB_DEFAULT_LAYOUT=us cargo test --workspace --locked
fi
cargo check --manifest-path fuzz/Cargo.toml --locked
python3 -m unittest discover -s sidecars/speech -p 'test_*.py'
scripts/test-try
scripts/prose-lint
