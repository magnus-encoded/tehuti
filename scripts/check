#!/usr/bin/env bash
# The full gate CI runs: format, lints, tests, prose rules.
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "${1:-}" = --quick ]; then
    # Pre-push floor: fmt plus clippy on crates changed against origin/main. Not a substitute for the full gate.
    cargo fmt --all --check
    args=
    dirs=$(git diff --name-only origin/main...HEAD -- 'crates/*/*' | cut -d/ -f2 | sort -u)
    if git diff --name-only origin/main...HEAD | grep -qxE 'Cargo\.(toml|lock)'; then
        dirs=$(ls crates)
    fi
    for dir in $dirs; do
        [ -f "crates/$dir/Cargo.toml" ] || continue
        name=$(sed -n 's/^name *= *"\(.*\)"/\1/p' "crates/$dir/Cargo.toml" | head -n1)
        args="$args -p $name"
    done
    # shellcheck disable=SC2086
    [ -z "$args" ] || cargo clippy -j1 $args --all-targets --locked -- -D warnings
    exit
fi
scripts/forbidden-paths
scripts/test-forbidden-paths
if [ -n "$(find crates -name Cargo.toml 2>/dev/null)" ]; then
    cargo fmt --all --check
    cargo clippy --workspace --all-targets --locked -- -D warnings
    # The keymap fallback tests need a stable advertised map across hosts.
    XKB_DEFAULT_LAYOUT=us cargo test --workspace --locked -- --test-threads=1
fi
cargo check --manifest-path fuzz/Cargo.toml --locked
python3 -m unittest discover -s sidecars/speech -p 'test_*.py'
scripts/test-try
scripts/test-install-release
scripts/test-tehuti-update
python3 -m unittest discover -s scripts -p 'test_*.py'
scripts/test-session
scripts/test-pr-body
scripts/test-pre-push
scripts/prose-lint
