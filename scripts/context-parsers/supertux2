#!/usr/bin/env python3
"""Read the SuperTux 2 SDL2 keymap and print JSON roles."""
import json
import os
from pathlib import Path
import re
import sys

from keycodes import binding


def parse(text):
    tokens = re.findall(r';[^\n]*|\(|\)|"(?:\\.|[^"\\])*"|[^\s()]+', text)
    stack = [[]]
    for token in tokens:
        if token.startswith(';'):
            continue
        if token == '(':
            node = []
            stack[-1].append(node)
            stack.append(node)
        elif token == ')':
            if len(stack) == 1:
                raise ValueError('unbalanced config')
            stack.pop()
        else:
            stack[-1].append(json.loads(token) if token.startswith('"') else token)
    if len(stack) != 1:
        raise ValueError('unbalanced config')
    return stack[0]


def child(node, name):
    return next((item for item in node if isinstance(item, list) and item and item[0] == name), [])


def main():
    default = Path(os.environ.get('XDG_DATA_HOME', Path.home() / '.local/share')) / 'supertux2/config'
    path = Path(sys.argv[1]) if len(sys.argv) > 1 else default
    tree = child(parse(path.read_text()), 'supertux-config')
    keymap = child(child(tree, 'control'), 'keymap')
    if not keymap or child(keymap, 'sdl2') != ['sdl2', '#t']:
        raise ValueError('expected an SDL2 keymap')
    actions, commands = {}, {}
    for node in keymap[1:]:
        if not isinstance(node, list) or not node or node[0] != 'map':
            continue
        key, control = child(node, 'key'), child(node, 'control')
        if len(key) != 2 or len(control) != 2:
            raise ValueError('invalid key mapping')
        value = binding(int(key[1]))
        if value is None:
            print('unsupported SDL key code: ' + key[1], file=sys.stderr)
            continue
        role = {'escape': 'back'}.get(control[1], control[1])
        actions.setdefault(role, value)
    for role, command in (('start', 'pause'), ('back', 'close')):
        if role in actions:
            commands[command] = actions[role]
    print(json.dumps({'actions': actions, 'commands': commands}, sort_keys=True))


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        sys.exit(str(error))
