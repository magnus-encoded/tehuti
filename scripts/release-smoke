#!/usr/bin/env bash
set -euo pipefail
[ "$#" -eq 2 ] || { echo 'Usage: release-smoke BIN_DIRECTORY OUTPUT_DIRECTORY' >&2; exit 1; }
binary=$(realpath "$1")
mkdir -p "$2"
output=$(realpath "$2")
work=$(mktemp -d)
export XDG_PICTURES_DIR="$work/pictures"
socket=''
drive() { "$binary/tehuti-drive" --socket "$socket" "$@"; }
cleanup() {
    if [ -n "$socket" ]; then drive stop || true; fi
    for session in start window; do
        if [ -f "$work/$session/session.log" ]; then
            mkdir -p "$output/$session"
            cp "$work/$session/session.log" "$output/$session/"
        fi
    done
    rm -rf "$work"
}
trap cleanup EXIT
# Render on the wallpaper of the tag's major version, from the packed assets.
major=${TAG#v}
major=${major%%.*}
[[ "$major" =~ ^[0-9]+$ ]] || { echo "release-smoke: TAG must look like v1.2.3" >&2; exit 1; }
codename=$(sed -n '/^pub const CODENAMES/,/^];/p' "$(dirname "$0")/../crates/compositor/src/wallpaper.rs" | grep -oE '"[a-z]+"' | sed -n "$((major + 1))p" | tr -d '"')
[ -n "$codename" ] || { echo "release-smoke: no wallpaper for major $major" >&2; exit 1; }
[ -f "$binary/wallpapers.pak" ] || { echo "release-smoke: $binary/wallpapers.pak missing" >&2; exit 1; }
# tehuti-drive isolates the session's XDG directories, so hand it the wallpaper to copy in.
mkdir -p "$work/wallpaper-seed"
cp "$binary/wallpapers.pak" "$work/wallpaper-seed/wallpapers.pak"
printf '%s' "$codename" > "$work/wallpaper-seed/wallpaper"
export TEHUTI_DRIVE_WALLPAPER_SEED="$work/wallpaper-seed" TEHUTI_ALL_WALLPAPERS=1
mkdir "$work/contexts"
printf 'app_id = "*"\n' > "$work/contexts/context.toml"
cat > "$work/contexts/destinations.toml" <<'TOML'
[[destinations]]
name = "Library"
[[destinations.routes]]
steps = [{ icon = "book", target = { kind = "action", value = { type = "notice", text = "Library" } } }]
TOML
socket="$work/start/tehuti-drive.sock"
drive start "$work/contexts" --headless --size 1280x720
drive wait-for /windows '[]'
drive shot "$output/start-screen.png"
drive stop
socket="$work/window/tehuti-drive.sock"
drive start "$work/contexts" --headless --size 1280x720 -- foot --title 'Release smoke' sh -c 'printf "Release smoke\\n"; exec sleep 300'
drive wait-for /windows/0/mapped true
sleep 1
drive shot "$output/bar.png"
drive say 'open library'
drive wait-for /launcher/rows/0/name '"Library"'
drive shot "$output/launcher.png"
python3 - "$output" <<'PYTHON'
from pathlib import Path
from PIL import Image
import sys

directory = Path(sys.argv[1])
with Image.open(directory / "bar.png") as bar, Image.open(directory / "launcher.png") as launcher:
    with Image.open(directory / "start-screen.png") as start:
        if start.convert("RGB").getpixel((40, 50)) == (0, 0, 0):
            raise SystemExit("release-smoke: start screen background is black; the wallpaper did not render")
    pixel = bar.getpixel((100, 100))
    if pixel[:3] == (0, 0, 0) or launcher.getpixel((100, 100)) != pixel:
        raise SystemExit("Launcher must leave the terminal visible")
PYTHON
drive press B
drive hold guide
drive clock advance 500
drive release guide
drive wait-for /overlays/menu true
drive press dpad_up
drive press dpad_up
drive press dpad_up
drive press A
drive wait-for /overlays/settings true
drive shot "$output/settings.png"
drive press B
drive say keyboard
drive wait-for /overlays/keyboard true
drive shot "$output/keyboard.png"
