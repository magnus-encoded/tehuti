#!/usr/bin/env python3
"""Send a phrase to a compositor started with TEHUTI_SAY=1."""
import os
from pathlib import Path
import stat
import sys


def main():
    if not sys.argv[1:] or any('\n' in word or '\r' in word for word in sys.argv[1:]):
        raise ValueError('usage: tehuti-say PHRASE (one line)')
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if not runtime:
        raise ValueError('XDG_RUNTIME_DIR is required')
    phrase = ' '.join(sys.argv[1:])
    if not phrase.strip():
        raise ValueError('phrase must not be empty')
    payload = (phrase + '\n').encode('utf-8')
    descriptor = os.open(Path(runtime) / 'tehuti-say',
                         os.O_WRONLY | os.O_NONBLOCK | os.O_NOFOLLOW)
    try:
        if not stat.S_ISFIFO(os.fstat(descriptor).st_mode):
            raise ValueError('tehuti-say path must be a FIFO')
        if len(payload) > os.fpathconf(descriptor, 'PC_PIPE_BUF'):
            raise ValueError('phrase exceeds the FIFO atomic write limit')
        os.write(descriptor, payload)
    finally:
        os.close(descriptor)


if __name__ == '__main__':
    try:
        main()
    except (OSError, ValueError) as error:
        print(f'tehuti-say: {error}', file=sys.stderr)
        sys.exit(1)
