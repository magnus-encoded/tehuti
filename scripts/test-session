#!/usr/bin/env python3
"""Exercise session switching with isolated executables."""
import os
from pathlib import Path
import subprocess
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent


class SessionTests(unittest.TestCase):
    def run_session(self, statuses, times=None, plasma=True, missing_binary=False,
                    plasma_statuses=None, date_failure=False, plasma_active=False,
                    plasma_active_statuses=None):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            bin_dir = root / 'bin'
            bin_dir.mkdir()
            for name in ['mkdir', 'sed', 'mv', 'wc', 'date']:
                (bin_dir / name).symlink_to('/bin/' + name)
            def stub(name, body):
                path = bin_dir / name
                path.write_text('#!/bin/sh\n' + body)
                path.chmod(0o755)
            stub('tehuti', '''echo tehuti >>"$TRACE"
read -r status <"$STATUSES"
sed '1d' "$STATUSES" >"$STATUSES.next"
mv "$STATUSES.next" "$STATUSES"
exit "$status"
''')
            if plasma:
                (root / 'plasma-statuses').write_text(
                    '\n'.join(map(str, plasma_statuses if plasma_statuses is not None else [0] * 5)) + '\n')
                stub('startplasma-wayland', '''echo plasma >>"$TRACE"
read -r status <"$PLASMA_STATUSES"
[ -n "$status" ] || { kill -TERM "$PPID"; exit 0; }
sed '1d' "$PLASMA_STATUSES" >"$PLASMA_STATUSES.next"
mv "$PLASMA_STATUSES.next" "$PLASMA_STATUSES"
exit "$status"
''')
            stub('systemctl', '''[ "$*" = '--user is-active --quiet plasma-workspace.target' ] || exit 2
if [ -s "$PLASMA_ACTIVE_STATUSES" ]; then
    read -r status <"$PLASMA_ACTIVE_STATUSES"
    sed '1d' "$PLASMA_ACTIVE_STATUSES" >"$PLASMA_ACTIVE_STATUSES.next"
    mv "$PLASMA_ACTIVE_STATUSES.next" "$PLASMA_ACTIVE_STATUSES"
    exit "$status"
fi
exit "$PLASMA_ACTIVE_STATUS"
''')
            stub('sleep', 'echo "sleep $*" >>"$TRACE"\n')
            if date_failure:
                (bin_dir / 'date').unlink()
                stub('date', 'exit 1\n')
            if times:
                (bin_dir / 'date').unlink()
                stub('date', '''read -r now <"$TIMES"
sed '1d' "$TIMES" >"$TIMES.next"
mv "$TIMES.next" "$TIMES"
echo "$now"
''')
            (root / 'statuses').write_text('\n'.join(map(str, statuses)) + '\n')
            (root / 'times').write_text('\n'.join(map(str, times or [])) + '\n')
            (root / 'plasma-active-statuses').write_text(
                '\n'.join(map(str, plasma_active_statuses or [])) + '\n'
                if plasma_active_statuses else '')
            env = dict(os.environ, PATH=str(bin_dir),
                       PLASMA_ACTIVE_STATUSES=str(root / 'plasma-active-statuses'),
                       PLASMA_ACTIVE_STATUS='0' if plasma_active else '3',
                       XDG_STATE_HOME=str(root), TRACE=str(root / 'trace'),
                       STATUSES=str(root / 'statuses'), TIMES=str(root / 'times'),
                       PLASMA_STATUSES=str(root / 'plasma-statuses'),
                       TEHUTI_BINARY=str(bin_dir / ('absent' if missing_binary else 'tehuti')))
            result = subprocess.run(['/bin/sh', str(ROOT / 'dist/tehuti-session')],
                                    env=env, timeout=5, capture_output=True)
            trace = (root / 'trace').read_text().splitlines()
            log = (root / 'tehuti/session.log').read_text()
            return result.returncode, trace, log

    def test_switch_helper_requests_plasma_logout(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            qdbus = root / 'qdbus'
            qdbus.write_text('#!/bin/sh\nprintf "%s\\n" "$@" >"$TRACE"\n')
            qdbus.chmod(0o755)
            env = dict(os.environ, PATH=str(root), TRACE=str(root / 'trace'))
            result = subprocess.run(['/bin/sh', str(ROOT / 'dist/tehuti-switch')],
                                    env=env, capture_output=True, timeout=5)
            self.assertEqual(result.returncode, 0)
            self.assertEqual((root / 'trace').read_text().splitlines(),
                             ['org.kde.Shutdown', '/Shutdown', 'logout'])
            qdbus.unlink()
            result = subprocess.run(['/bin/sh', str(ROOT / 'dist/tehuti-switch')],
                                    env=env, capture_output=True, timeout=5)
            self.assertEqual(result.returncode, 1)
            self.assertIn(b'Plasma Log Out shortcut', result.stderr)

    def test_switch_returns_and_logout_ends_login(self):
        code, trace, _ = self.run_session([20, 21])
        self.assertEqual(code, 0)
        self.assertEqual(trace, ['tehuti', 'plasma', 'tehuti'])

    def test_active_plasma_returns_to_tehuti(self):
        code, trace, log = self.run_session([20, 21], plasma_active=True)
        self.assertEqual(code, 0)
        self.assertEqual(trace, ['tehuti', 'tehuti'])
        self.assertIn('Plasma workspace already active; restarting Tehuti', log)

    def test_restart_relaunches_without_plasma_or_failure_lock(self):
        code, trace, log = self.run_session([75, 75, 75, 21])
        self.assertEqual(code, 0)
        self.assertEqual(trace, ['tehuti'] * 4)
        self.assertEqual(log.count('Tehuti exited with status 75'), 3)
        self.assertNotIn('staying in Plasma', log)

    def test_crash_and_term_open_plasma(self):
        for status in [1, 139, 143, 0]:
            with self.subTest(status=status):
                code, trace, _ = self.run_session([status, 21])
                self.assertEqual(code, 0)
                self.assertEqual(trace, ['tehuti', 'plasma', 'tehuti'])

    def test_three_recent_failures_stay_in_plasma(self):
        code, trace, log = self.run_session(
            [1, 1, 1, 21], [100, 130, 160], plasma_statuses=[0, 0, 1, 1])
        self.assertEqual(code, -15)
        self.assertEqual(trace, ['tehuti', 'plasma', 'tehuti', 'plasma',
                                 'tehuti', 'plasma', 'sleep 3', 'plasma',
                                 'sleep 3', 'plasma'])
        self.assertEqual(log.count('Tehuti exited with status 1'), 3)
        self.assertEqual(log.count('Plasma exited with status 1'), 2)
        self.assertIn('staying in Plasma', log)

    def test_crash_loop_with_active_plasma_stops_after_three_tehuti_starts(self):
        code, trace, log = self.run_session(
            [1, 1, 1, 21], [100, 110, 120], plasma_statuses=[1],
            plasma_active_statuses=[0, 0, 0, 0, 3])
        self.assertEqual(code, -15)
        self.assertEqual(trace, ['tehuti'] * 3 + ['sleep 3'] * 2
                         + ['plasma', 'sleep 3', 'plasma'])
        self.assertEqual(log.count('Tehuti exited with status 1'), 3)
        self.assertIn('staying in Plasma', log)

    def test_old_failure_does_not_lock_plasma(self):
        code, trace, _ = self.run_session([1, 1, 1, 21], [100, 130, 161])
        self.assertEqual(code, 0)
        self.assertEqual(trace.count('tehuti'), 4)

    def test_missing_plasma_retries_tehuti(self):
        code, trace, log = self.run_session([20, 21], plasma=False)
        self.assertEqual(code, 0)
        self.assertEqual(trace, ['tehuti', 'sleep 3', 'tehuti'])
        self.assertIn('missing; restarting Tehuti', log)

    def test_start_failure_opens_plasma(self):
        code, trace, log = self.run_session([], missing_binary=True)
        self.assertEqual(code, -15)
        self.assertEqual(trace.count('plasma'), 6)
        self.assertEqual(log.count('Tehuti exited with status 127'), 6)
        self.assertIn('/bin/absent', log)

    def test_plasma_failure_delays_retry(self):
        code, trace, log = self.run_session([20, 21], plasma_statuses=[7])
        self.assertEqual(code, 0)
        self.assertEqual(trace, ['tehuti', 'plasma', 'sleep 3', 'tehuti'])
        self.assertIn('Plasma exited with status 7', log)

    def test_logout_after_lock_resets_failure_count(self):
        code, trace, log = self.run_session(
            [1, 1, 1, 1, 21], [100, 110, 120, 130])
        self.assertEqual(code, 0)
        self.assertEqual(trace, ['tehuti', 'plasma'] * 4 + ['tehuti'])
        self.assertEqual(log.count('staying in Plasma'), 1)
        self.assertEqual(log.count('Tehuti exited with status 1'), 4)

    def test_failed_clock_does_not_end_session(self):
        code, trace, log = self.run_session([1, 21], date_failure=True)
        self.assertEqual(code, 0)
        self.assertEqual(trace, ['tehuti', 'plasma', 'tehuti'])
        self.assertIn('Tehuti exited with status 1', log)


if __name__ == '__main__':
    unittest.main()
