#!/usr/bin/env bash
# Local copy of the CI pr-body checks that need only the body file: issue reference, 120-word cap, prose rules.
# Usage: scripts/pr-body <body-file>
set -uo pipefail
cd "$(dirname "$0")/.."
[ $# -eq 1 ] && [ -f "$1" ] || { echo "usage: scripts/pr-body <body-file>"; exit 2; }
grep -qE '^(Closes|Fixes|Resolves) #[0-9]+' "$1" || { echo "PR body must reference the issue it answers: Closes #N"; exit 1; }
[ "$(wc -w < "$1")" -le 120 ] || { echo "PR body over 120 words"; exit 1; }
scripts/prose-lint "$1"
